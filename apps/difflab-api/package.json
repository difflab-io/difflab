{
  "name": "difflab-api",
  "version": "0.1.0",
  "private": true,
  "description": "Difflab Connect JSON-RPC server over Hono for hosted and self-hosted deployments",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "clean": "rm -rf dist coverage",
    "test": "bun test --pass-with-no-tests",
    "lint": "tsc --noEmit",
    "lint:fix": "bun run format && bun run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@bufbuild/protovalidate": "1.3.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/validate": "0.2.0",
    "difflab-config": "workspace:*",
    "difflab-db": "workspace:*",
    "hono": "4.13.8",
    "utils": "workspace:*"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.6",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  }
}
