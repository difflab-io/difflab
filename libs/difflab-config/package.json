{
  "name": "difflab-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Difflab paths, environment settings, and repository configuration",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "echo 'Source-only library: no build required'",
    "clean": "rm -rf dist coverage",
    "test": "bun test --pass-with-no-tests",
    "lint": "tsc --noEmit",
    "lint:fix": "bun run format && bun run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "c12": "^4.0.0-rc.4",
    "utils": "workspace:*",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.6",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  }
}
