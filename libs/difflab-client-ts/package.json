{
  "name": "difflab-client-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Private Connect JSON-RPC TypeScript client for Difflab services",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "echo 'Source-only library: no build required'",
    "clean": "rm -rf dist coverage",
    "test": "bun test --pass-with-no-tests",
    "lint": "tsc --noEmit",
    "lint:fix": "bun run format && bun run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-web": "2.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  }
}
