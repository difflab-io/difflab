{
  "name": "difflab-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Local background RPC server lifecycle and lock management for Difflab",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "echo 'Source-only library: no build required'",
    "clean": "rm -rf dist coverage",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "lint:fix": "bun run format && bun run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "difflab-config": "workspace:*",
    "proper-lockfile": "4.1.2",
    "utils": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  }
}
